# Liga a edição por IA via OpenRouter (obrigatório para a IA funcionar)
OPENROUTER_API_KEY=
# Modelo usado por clientes sem modelo próprio (id da OpenRouter)
# VITRINE_AI_MODEL=anthropic/claude-sonnet-5.5
# Motor da IA: vazio = padrão; claude-code = Claude Code no servidor, com skills
# em ai/claude/.claude/skills (precisa de servidor sempre ligado)
# VITRINE_AI_ENGINE=claude-code
# Créditos de boas-vindas de cada site novo (padrão 1000)
# VITRINE_FREE_CREDITS=1000

# Domínio raiz da plataforma: sites ficam em <slug>.<raiz>
VITRINE_ROOT_DOMAIN=vitrine.localhost
# Hosts que abrem o painel (separados por vírgula)
VITRINE_APP_HOSTS=localhost,127.0.0.1
# Destino do CNAME que os clientes configuram
# VITRINE_CNAME_TARGET=sites.suaempresa.com
# IP aceito em registro A (domínios sem www)
# VITRINE_PLATFORM_IP=

# Conta inicial da agência
# VITRINE_ADMIN_EMAIL=admin@suaempresa.com
# VITRINE_DEMO_PASSWORD=troque-esta-senha
# VITRINE_HIDE_DEMO=1

# Endereço do painel (links de convite e de nova senha)
# VITRINE_APP_URL=https://app.suaempresa.com

# Imagens em S3, Cloudflare R2 ou MinIO (sem isso, ficam em disco)
# VITRINE_S3_BUCKET=
# VITRINE_S3_REGION=auto
# VITRINE_S3_ENDPOINT=
# VITRINE_S3_PUBLIC_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# E-mail de convites e senhas (Resend)
# RESEND_API_KEY=
# VITRINE_MAIL_FROM=Vitrine <nao-responda@suaempresa.com>

# Domínios com HTTPS automático na Vercel
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
