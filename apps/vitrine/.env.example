# Liga a edição por IA (obrigatório para a IA funcionar)
ANTHROPIC_API_KEY=

# Domínio raiz da plataforma: sites ficam em <slug>.<raiz>
VITRINE_ROOT_DOMAIN=vitrine.localhost
# Hosts que abrem o painel (separados por vírgula)
VITRINE_APP_HOSTS=localhost,127.0.0.1
# Destino do CNAME que os clientes configuram
# VITRINE_CNAME_TARGET=sites.suaempresa.com
# IP aceito em registro A (domínios sem www)
# VITRINE_PLATFORM_IP=

# Conta inicial da agência
# VITRINE_ADMIN_EMAIL=admin@suaempresa.com
# VITRINE_DEMO_PASSWORD=troque-esta-senha
# VITRINE_HIDE_DEMO=1
